// vote_insert.sql
INSERT INTO Vote (VoteID, VoterID, CandidateID, ElectionID, VoteDate)
VALUES (vote_seq.NEXTVAL, :voter, :cand, :election, SYSDATE);
-- enforced by:  UNIQUE (VoterID, ElectionID)
-- ensures:      one ballot per voter per election
